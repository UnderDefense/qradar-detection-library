{
  "$id": "https://underdefense.com/schemas/reference-data.qradar.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QRadar reference data of a log source pack",
  "description": "Reference sets that ship in the pack's extension. One file per log source folder, named reference-data.yml. Rules refer to a set as '<name> - <type>', as the Rule Wizard shows it.",
  "type": "object",
  "properties": {
    "reference_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/referenceSet"
      }
    }
  },
  "required": [
    "reference_sets"
  ],
  "additionalProperties": false,
  "$defs": {
    "referenceSet": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": " - (IP|CIDR|Port|Numeric|Date|AlphaNumeric)( \\(Ignore Case\\))?$"
          },
          "description": "Reference set name without the type suffix."
        },
        "type": {
          "enum": [
            "AlphaNumeric",
            "Numeric",
            "IP",
            "Port",
            "AlphaNumeric (Ignore Case)",
            "Date",
            "CIDR"
          ],
          "description": "Element type as the Rule Wizard shows it after the name."
        },
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Elements to ship with the set. Leave out for an empty set that each console fills. Values must not be client-specific."
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "IP"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "anyOf": [
                    {
                      "format": "ipv4"
                    },
                    {
                      "format": "ipv6"
                    }
                  ],
                  "errorMessage": "IP reference sets take IPv4 or IPv6 addresses."
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "CIDR"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$",
                  "errorMessage": "CIDR reference sets take networks such as 10.0.0.0/8."
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Port"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "pattern": "^[0-9]{1,5}$",
                  "errorMessage": "Port reference sets take port numbers."
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Numeric"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                  "errorMessage": "Numeric reference sets take numbers."
                }
              }
            }
          }
        }
      ]
    }
  }
}
